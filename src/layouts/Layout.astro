---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Creative Engineer & Full-Stack Developer | Fernando Morán",
  description = "Fernando Morán es un desarrollador full-stack e ingeniero en ciencias de la computación enfocado en crear sistemas con precisión."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons & Web App Manifest (logo-kit) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#C4452F" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#343131" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Fernando Morán" />
    <title>{title}</title>

    <!-- Open Graph / LinkedIn / WhatsApp / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="Fernando Morán — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-preview.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="N. — Fernando Morán Portfolio" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-preview.png" />

    <!-- Neue Haas Grotesk Display (Typekit) + Geist Fallback -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://use.typekit.net/aql3kih.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-ink)] min-h-svh antialiased relative">
    <!-- Capa de Grano Analógico Global -->
    <div class="background-grain" aria-hidden="true"></div>

    <!-- Loader de Construcción en Pantalla Completa (logo-kit/loader/loader-construction-fullscreen.html) -->
    <div id="loader" role="status" aria-label="Cargando">
      <div class="stage">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <clipPath id="loader-clip-t"><rect width="64" height="64" rx="14" /></clipPath>
            <clipPath id="loader-clip-n">
              <polygon points="12.5,16 21.5,16 34.5,38.3 34.5,16 41.5,16 41.5,52 32.5,52 19.5,29.7 19.5,52 12.5,52" />
            </clipPath>
          </defs>
          <g class="guides">
            <line class="ln cons" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.00s" x1="12.5" y1="-1400" x2="12.5" y2="1464" />
            <line class="ln cons" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.04s" x1="19.5" y1="-1400" x2="19.5" y2="1464" />
            <line class="ln cons" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.08s" x1="34.5" y1="-1400" x2="34.5" y2="1464" />
            <line class="ln cons" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.12s" x1="41.5" y1="-1400" x2="41.5" y2="1464" />
            <line class="ln cons" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.16s" x1="-1400" y1="16" x2="1464" y2="16" />
            <line class="ln cons" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.20s" x1="-1400" y1="52" x2="1464" y2="52" />
            <line class="ln faint" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.24s" x1="-1400" y1="29.7" x2="1464" y2="29.7" />
            <line class="ln faint" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.28s" x1="-1400" y1="38.3" x2="1464" y2="38.3" />
            <line class="ln axis" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.32s" x1="32" y1="-1400" x2="32" y2="1464" />
            <line class="ln axis" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.32s" x1="-1400" y1="32" x2="1464" y2="32" />
            <line class="ln cons" style="--o1:0 0;--o2:100% 100%;animation-delay:0.32s" x1="-803.971" y1="-1400" x2="865.626" y2="1464" />
            <line class="ln cons" style="--o1:0 0;--o2:100% 100%;animation-delay:0.37s" x1="-813.957" y1="-1400" x2="855.639" y2="1464" />
            <line class="ln orig" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.45s" x1="49" y1="-1400" x2="49" y2="1464" />
            <line class="ln orig" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.45s" x1="-1400" y1="47.5" x2="1464" y2="47.5" />
          </g>
          <rect class="frame" width="64" height="64" rx="14" />
          <g clip-path="url(#loader-clip-n)">
            <path class="trace" d="M16 58V10L41 58V10" fill="none" stroke="#f9fafb" stroke-width="14" />
          </g>
          <g class="outline">
            <line class="ol" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.00s" x1="12.5" y1="16" x2="21.5" y2="16" />
            <line class="ol" style="--o1:0 0;--o2:100% 100%;animation-delay:0.05s" x1="21.5" y1="16" x2="34.5" y2="38.3" />
            <line class="ol" style="--o1:50% 100%;--o2:50% 0;animation-delay:0.10s" x1="34.5" y1="38.3" x2="34.5" y2="16" />
            <line class="ol" style="--o1:0 50%;--o2:100% 50%;animation-delay:0.15s" x1="34.5" y1="16" x2="41.5" y2="16" />
            <line class="ol" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.20s" x1="41.5" y1="16" x2="41.5" y2="52" />
            <line class="ol" style="--o1:100% 50%;--o2:0 50%;animation-delay:0.25s" x1="41.5" y1="52" x2="32.5" y2="52" />
            <line class="ol" style="--o1:100% 100%;--o2:0 0;animation-delay:0.30s" x1="32.5" y1="52" x2="19.5" y2="29.7" />
            <line class="ol" style="--o1:50% 0;--o2:50% 100%;animation-delay:0.35s" x1="19.5" y1="29.7" x2="19.5" y2="52" />
            <line class="ol" style="--o1:100% 50%;--o2:0 50%;animation-delay:0.40s" x1="19.5" y1="52" x2="12.5" y2="52" />
            <line class="ol" style="--o1:50% 100%;--o2:50% 0;animation-delay:0.45s" x1="12.5" y1="52" x2="12.5" y2="16" />
          </g>
          <rect class="nd" x="11.2" y="14.7" width="2.6" height="2.6" style="animation-delay:0.00s" />
          <rect class="nd" x="20.2" y="14.7" width="2.6" height="2.6" style="animation-delay:0.05s" />
          <rect class="nd" x="33.2" y="37" width="2.6" height="2.6" style="animation-delay:0.10s" />
          <rect class="nd" x="33.2" y="14.7" width="2.6" height="2.6" style="animation-delay:0.15s" />
          <rect class="nd" x="40.2" y="14.7" width="2.6" height="2.6" style="animation-delay:0.20s" />
          <rect class="nd" x="40.2" y="50.7" width="2.6" height="2.6" style="animation-delay:0.25s" />
          <rect class="nd" x="31.2" y="50.7" width="2.6" height="2.6" style="animation-delay:0.30s" />
          <rect class="nd" x="18.2" y="28.4" width="2.6" height="2.6" style="animation-delay:0.35s" />
          <rect class="nd" x="18.2" y="50.7" width="2.6" height="2.6" style="animation-delay:0.40s" />
          <rect class="nd" x="11.2" y="50.7" width="2.6" height="2.6" style="animation-delay:0.45s" />
          <circle class="ring" cx="49" cy="47.5" r="4.75" />
          <circle class="dot" cx="49" cy="47.5" r="4.75" fill="#C4452F" stroke="none" />
        </svg>
      </div>
      <span class="meta tl">N.</span>
      <span class="meta tr">01 // 01</span>
      <span class="meta bl">Cargando</span>
      <span class="meta br" id="pct">000</span>
    </div>

    <script is:inline>
      (function () {
        var L = document.getElementById('loader');
        var el = document.getElementById('pct');
        var navEntry =
          typeof performance !== 'undefined' && performance.getEntriesByType
            ? performance.getEntriesByType('navigation')[0]
            : null;
        var isReload = navEntry ? navEntry.type === 'reload' : false;
        var seenInSession = false;
        try {
          seenInSession = sessionStorage.getItem('nando_loader_seen') === '1';
        } catch (_) {}

        var shouldShowLoader = !seenInSession || isReload;

        if (!shouldShowLoader) {
          if (L) L.classList.add('skip');
          window.__portfolioLoaderDone = true;
          return;
        }

        try {
          sessionStorage.setItem('nando_loader_seen', '1');
        } catch (_) {}

        document.documentElement.setAttribute('data-loader-active', '');

        var t0 = performance.now();
        var D = 3400;
        function ease(x) {
          return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2;
        }
        function tick(now) {
          var p = Math.min(1, (now - t0) / D);
          if (el) el.textContent = String(Math.round(ease(p) * 100)).padStart(3, '0');
          if (p < 1) {
            requestAnimationFrame(tick);
          } else {
            setTimeout(function () {
              document.documentElement.removeAttribute('data-loader-active');
              if (L) L.classList.add('done');
              window.__portfolioLoaderDone = true;
              window.dispatchEvent(new CustomEvent('portfolio:loader-done'));
            }, 850);
          }
        }
        requestAnimationFrame(tick);
      })();
    </script>

    <slot />

    <style is:global>
      #loader {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--color-bg, #343131);
        overflow: hidden;
        transition: opacity 0.735s cubic-bezier(0.625, 0.05, 0, 1);
      }
      #loader.done {
        opacity: 0;
        pointer-events: none;
      }
      #loader.skip {
        display: none !important;
      }
      #loader .stage {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0;
        height: 0;
      }
      #loader .stage svg {
        position: absolute;
        width: var(--s, 160px);
        height: var(--s, 160px);
        left: calc(var(--s, 160px) / -2);
        top: calc(var(--s, 160px) / -2);
        overflow: visible;
        display: block;
      }
      #loader .meta {
        position: absolute;
        font-family: var(--font-mono, "Geist Mono", ui-monospace, monospace);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-muted, #979595);
      }
      #loader .tl {
        top: 24px;
        left: 24px;
      }
      #loader .tr {
        top: 24px;
        right: 24px;
      }
      #loader .bl {
        bottom: 24px;
        left: 24px;
      }
      #loader .br {
        bottom: 24px;
        right: 24px;
        color: var(--color-ink, #f9fafb);
        font-variant-numeric: tabular-nums;
      }
      @media (min-width: 900px) {
        #loader {
          --s: 200px;
        }
      }

      #loader svg line,
      #loader svg rect,
      #loader svg circle {
        vector-effect: non-scaling-stroke;
        transform-box: fill-box;
      }
      #loader .ln,
      #loader .ol {
        fill: none;
        stroke-width: 1;
      }
      #loader .cons {
        stroke: #979595;
        opacity: 0.55;
      }
      #loader .faint {
        stroke: #4a4747;
        opacity: 1;
      }
      #loader .axis {
        stroke: #4a4747;
        opacity: 0.9;
      }
      #loader .orig {
        stroke: #C4452F;
        opacity: 0.85;
      }
      #loader .ol {
        stroke: #f9fafb;
      }
      #loader .nd {
        fill: #343131;
        stroke: #f9fafb;
        stroke-width: 1;
        transform-origin: 50% 50%;
      }
      #loader .ring {
        fill: none;
        stroke: #C4452F;
        stroke-width: 1;
      }
      #loader .frame {
        fill: none;
        stroke: #4a4747;
        stroke-width: 1;
      }
      #loader .trace {
        stroke-dasharray: 152;
        vector-effect: none;
      }
      #loader .dot {
        transform-origin: 50% 50%;
      }
      #loader .ln {
        animation: loader-ln 4.6s var(--relay-ease, cubic-bezier(0.625, 0.05, 0, 1)) 1 forwards;
      }
      #loader .ol {
        animation: loader-ol 4.6s var(--relay-ease, cubic-bezier(0.625, 0.05, 0, 1)) 1 forwards;
      }
      #loader .nd {
        animation: loader-nd 4.6s var(--relay-ease, cubic-bezier(0.625, 0.05, 0, 1)) 1 forwards;
      }
      #loader .guides {
        animation: loader-dim 4.6s linear 1 forwards;
      }
      #loader .trace {
        stroke-dashoffset: 152;
        animation: loader-draw 4.6s var(--relay-ease, cubic-bezier(0.625, 0.05, 0, 1)) 1 forwards;
      }
      #loader .ring {
        animation: loader-ring 4.6s linear 1 forwards;
      }
      #loader .dot {
        opacity: 0;
        transform: translateY(6px) scale(0.4);
        animation: loader-dot 4.6s var(--relay-ease, cubic-bezier(0.625, 0.05, 0, 1)) 1 forwards;
      }
      #loader .frame {
        opacity: 0;
        animation: loader-frame 4.6s linear 1 forwards;
      }

      @media (prefers-reduced-motion: reduce) {
        #loader .ln,
        #loader .ol,
        #loader .guides,
        #loader .trace,
        #loader .dot,
        #loader .frame {
          animation: none;
          transform: none;
          opacity: 1;
          stroke-dashoffset: 0;
        }
        #loader .guides {
          opacity: 0.4;
        }
        #loader .nd,
        #loader .ring {
          animation: none;
          opacity: 0;
        }
      }

      @keyframes loader-ln {
        0% {
          transform-origin: var(--o1);
          transform: scale(0);
        }
        27.03% {
          transform-origin: var(--o1);
          transform: scale(1);
        }
        98.65% {
          transform-origin: var(--o1);
          transform: scale(1);
        }
        100% {
          transform-origin: var(--o2);
          transform: scale(1);
        }
      }
      @keyframes loader-dim {
        0% {
          opacity: 1;
        }
        81.08% {
          opacity: 1;
        }
        97.3% {
          opacity: 0.4;
        }
        100% {
          opacity: 0.4;
        }
      }
      @keyframes loader-ol {
        0% {
          transform-origin: var(--o1);
          transform: scale(0);
        }
        35.14% {
          transform-origin: var(--o1);
          transform: scale(0);
        }
        54.05% {
          transform-origin: var(--o1);
          transform: scale(1);
        }
        98.65% {
          transform-origin: var(--o1);
          transform: scale(1);
        }
        100% {
          transform-origin: var(--o2);
          transform: scale(1);
        }
      }
      @keyframes loader-nd {
        0% {
          opacity: 0;
          transform: scale(0.4);
        }
        40.54% {
          opacity: 0;
          transform: scale(0.4);
        }
        51.35% {
          opacity: 1;
          transform: none;
        }
        78.38% {
          opacity: 1;
          transform: none;
        }
        89.19% {
          opacity: 0;
          transform: scale(0.4);
        }
        100% {
          opacity: 0;
          transform: scale(0.4);
        }
      }
      @keyframes loader-draw {
        0% {
          stroke-dashoffset: 152;
        }
        59.46% {
          stroke-dashoffset: 152;
        }
        83.78% {
          stroke-dashoffset: 0;
        }
        100% {
          stroke-dashoffset: 0;
        }
      }
      @keyframes loader-ring {
        0% {
          opacity: 0;
        }
        48.65% {
          opacity: 0;
        }
        62.16% {
          opacity: 1;
        }
        78.38% {
          opacity: 1;
        }
        86.49% {
          opacity: 0;
        }
        100% {
          opacity: 0;
        }
      }
      @keyframes loader-dot {
        0% {
          opacity: 0;
          transform: translateY(6px) scale(0.4);
        }
        78.38% {
          opacity: 0;
          transform: translateY(6px) scale(0.4);
        }
        91.89% {
          opacity: 1;
          transform: none;
        }
        100% {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes loader-frame {
        0% {
          opacity: 0;
        }
        13.51% {
          opacity: 1;
        }
        100% {
          opacity: 1;
        }
      }
    </style>
  </body>
</html>
