        // 4: Full-Stack Developer
        [
          ["   (O) [#]", "   /|==// ", "  / |     ", "   / \\    ", "  /   \\   ", " _/    \\_ "],
          ["   (O) [#]", "   /|==// ", "    |     ", "   /|     ", "  / |     ", "  \\ _\\    "],
          ["   (O) [#]", "   /|==// ", "  / |     ", "   \\ \\    ", "    \\ \\   ", "    _\\ \\_ "]
        ]
      ];

      const groundPattern = "= - = = - - = = = - = = - = = - = = = - - = = - = = = - = = ";
      const eraLabels = [
        "3.8M BCE · Pan troglodytes (Knuckle-walking)",
        "2.4M BCE · Australopithecus (First bipedal steps)",
        "1.5M BCE · Homo erectus (Fire & tool discovery)",
        "200K BCE · Homo sapiens (Language, art & reason)",
        "2026 CE · Full-Stack Developer (Building in terminal)"
      ];

      let asciiMode = 'parade'; // 'parade' | 'walker'
      const speeds = [0.5, 1, 1.75];
      let speedIdx = 0;
      let frameIdx = 0;
      let scrollOffset = 0;
      let walkerX = -6;
      let lastTick = performance.now();
      let isVisible = true;

      function renderParade() {
        const lines = [];
        for (let r = 0; r < 6; r++) {
          let row = '';
          for (let s = 0; s < 5; s++) {
            row += stagesArt[s][frameIdx % 3][r] + (s < 4 ? ' ' : '');
          }
          lines.push(row.slice(0, TOTAL_COLS));
        }
        const fullGround = groundPattern + groundPattern + groundPattern;
        const gSlice = fullGround.slice(scrollOffset % groundPattern.length, (scrollOffset % groundPattern.length) + TOTAL_COLS);
        lines.push(gSlice);
        lines.push("Ape       Australo     Erectus      Sapiens      Coder   ");
        asciiScreen.textContent = lines.join('\n');
        if (asciiEpoch) asciiEpoch.textContent = "3.8M BCE → 2026 CE // MARCH OF PROGRESS";
      }

      function renderWalker() {
        let st = 0;
        if (walkerX < 6) st = 0;
        else if (walkerX < 17) st = 1;
        else if (walkerX < 28) st = 2;
        else if (walkerX < 39) st = 3;
        else st = 4;

        const art = stagesArt[st][frameIdx % 3];
        const lines = [];
        for (let r = 0; r < 6; r++) {
          const artRow = art[r];
          let rowStr = '';
          if (walkerX < 0) {
            const cut = -walkerX;
            rowStr = (artRow.slice(cut) + ' '.repeat(TOTAL_COLS)).slice(0, TOTAL_COLS);
          } else {
            rowStr = (' '.repeat(walkerX) + artRow + ' '.repeat(TOTAL_COLS)).slice(0, TOTAL_COLS);
          }
          lines.push(rowStr);
        }
        lines.push('='.repeat(TOTAL_COLS));
        const timeline = "3.8M BCE . . . 2.4M BCE . . . 1.5M BCE . . . 200K BCE . . 2026 CE";
        lines.push(timeline.slice(0, TOTAL_COLS));
        asciiScreen.textContent = lines.join('\n');
        if (asciiEpoch) asciiEpoch.textContent = eraLabels[st];
      }

      function tickAscii(now) {
        if (!isVisible) {
          requestAnimationFrame(tickAscii);
          return;
        }

        const baseInterval = 130 / speeds[speedIdx];
        if (now - lastTick >= baseInterval) {
          lastTick = now;
          frameIdx = (frameIdx + 1) % 3;
          scrollOffset = (scrollOffset + 1) % groundPattern.length;

          if (asciiMode === 'parade') {
            renderParade();
          } else {
            walkerX += 1;
            if (walkerX > TOTAL_COLS + 2) walkerX = -8;
            renderWalker();
          }
        }
        requestAnimationFrame(tickAscii);
      }

      // Intersection Observer para pausar cuando no sea visible en pantalla
      const obs = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0.1 });
      obs.observe(asciiWindow);

      function toggleMode() {
        asciiMode = asciiMode === 'parade' ? 'walker' : 'parade';
