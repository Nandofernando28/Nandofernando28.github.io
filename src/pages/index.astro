    planeEls.forEach((el) => {
      el.addEventListener('click', (e) => {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const slotIdx = Number(el.dataset.plane);
        const projIdx = Number(el.dataset.projectIndex);
        const rk = loopRank(slotIdx - offsetD, instanceCount);

        if (Math.abs(rk) < 0.25) {
          openProjectDrawer(projIdx);
        } else {
          // Deslizar suavemente hacia la tarjeta clicada
          stateH = 'snapping';
          snapStartOffset = offsetD;
          snapTargetOffset = Math.round(offsetD + rk);
          snapProgress = 0;
          ensureGalleryLoop();
        }
      });
    });

