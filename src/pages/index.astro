  <!-- Script Maestro: LinkRelay (mod_75669), ChannelSplit (mod_38699/12674), GalleryCanvas Hermite Physics (mod_96767/11715) y HoverPill (mod_22736) -->
  <script define:vars={{ projects }}>
    // =========================================================================
    // 1. FECHA DINÁMICA ESTILO J.MR (mod_10444: "October ‘26")
    // =========================================================================
    const dateEl = document.getElementById('availability-date');
    if (dateEl) {
      const now = new Date();
      const month = now.toLocaleString('en-US', { month: 'long' });
      const yr = String(now.getFullYear()).slice(-2);
      dateEl.textContent = `${month} ‘${yr}`;
    }

    // =========================================================================
    // 2. LINK RELAY INTERACTION (mod_75669: relay-leave + relay-enter)
    // =========================================================================
    function initLinkRelays() {
      if (!window.matchMedia('(hover: hover)').matches) return;
      document.querySelectorAll('.link-relay').forEach((span) => {
        const parent = span.parentElement || span;
        parent.addEventListener('pointerenter', () => {
          if (!('relay' in span.dataset)) {
            span.dataset.relay = '';
          }
        });
        span.addEventListener('animationend', (e) => {
          if (e.animationName === 'relay-enter') {
            delete span.dataset.relay;
          }
        });
      });
    }
    initLinkRelays();

    // =========================================================================
    // 3. FUNCIONES DE FÍSICA COMPARTIDAS (mod_11715 & mod_12674)
    // =========================================================================
    const clampSym = (val, max) => Math.min(Math.max(val, -max), max);

    function decayVelocity(vel, dt, friction) {
      return vel * Math.pow(friction, 60 * dt);
    }

    function depositSplit(current, dx, dy, gain, max) {
      return {
        x: clampSym(current.x + dx * gain, max),
        y: clampSym(current.y + dy * gain, max)
      };
    }

    function drainSplit(current, dt, friction, eps) {
      const next = {
        x: decayVelocity(current.x, dt, friction),
        y: decayVelocity(current.y, dt, friction)
      };
      return Math.abs(next.x) < eps && Math.abs(next.y) < eps ? { x: 0, y: 0 } : next;
    }

    // =========================================================================
    // 4. RETRATO CHANNEL SPLIT CON FÍSICA DE FRICCIÓN 0.86 (mod_38699)
    // =========================================================================
    const portraitWrapper = document.getElementById('portrait-wrapper');
    const portraitImg = document.getElementById('portrait-img');
    const feRed = document.getElementById('fe-red-offset');
    const feBlue = document.getElementById('fe-blue-offset');

    let portraitSplit = { x: 0, y: 0 };
    let portraitLastPointer = null;
    let portraitRaf = null;
    let portraitLastTime = 0;
    const PORTRAIT_TUNING = { gain: 0.14, max: 6.5, friction: 0.86 };

    function tickPortraitSplit(now) {
      const dt = Math.min((now - portraitLastTime) / 1000, 1 / 30);
      portraitLastTime = now;
      portraitSplit = drainSplit(portraitSplit, dt, PORTRAIT_TUNING.friction, 0.02);

      if (feRed && feBlue && portraitImg) {
        feRed.setAttribute('dx', String(portraitSplit.x.toFixed(2)));
        feRed.setAttribute('dy', String(portraitSplit.y.toFixed(2)));
        feBlue.setAttribute('dx', String((-portraitSplit.x).toFixed(2)));
        feBlue.setAttribute('dy', String((-portraitSplit.y).toFixed(2)));
        portraitImg.style.filter =
          portraitSplit.x === 0 && portraitSplit.y === 0
            ? 'grayscale(100%) contrast(1.1)'
            : 'url(#channel-split-portrait) grayscale(100%) contrast(1.1)';
      }

      portraitRaf =
        portraitSplit.x === 0 && portraitSplit.y === 0
          ? null
          : requestAnimationFrame(tickPortraitSplit);
    }

    portraitWrapper?.addEventListener('pointermove', (e) => {
      if (portraitLastPointer) {
        portraitSplit = depositSplit(
          portraitSplit,
          e.clientX - portraitLastPointer.x,
          e.clientY - portraitLastPointer.y,
          PORTRAIT_TUNING.gain,
          PORTRAIT_TUNING.max
        );
        if (portraitRaf === null) {
          portraitLastTime = performance.now();
          portraitRaf = requestAnimationFrame(tickPortraitSplit);
        }
      }
      portraitLastPointer = { x: e.clientX, y: e.clientY };
    });

    portraitWrapper?.addEventListener('pointerleave', () => {
      portraitLastPointer = null;
    });

    // =========================================================================
    // 5. GALLERY CANVAS: HERMITE LAYOUT + VELOCITY/CURSOR RGB SPLIT + HOVER PILL
    //    (Traducción exacta de mod_11715, mod_96767 y mod_22736)
    // =========================================================================
    const boundsEl = document.getElementById('gallery-bounds');
    const gutterProbe = document.getElementById('gutter-probe');
    const planeEls = Array.from(document.querySelectorAll('.gallery-plane'));
    const clientEl = document.getElementById('active-client');
    const roleEl = document.getElementById('active-role');
    const counterEl = document.getElementById('gallery-counter');

    // HoverPill refs
    const pillMaskEl = document.getElementById('hover-pill-mask');
    const pillBoxEl = document.getElementById('hover-pill-box');
    const pillBgEl = document.getElementById('hover-pill-bg');
    const pillMarqueeEl = document.getElementById('hover-pill-marquee');

    const M = projects.length;
    const instanceCount = planeEls.length; // 10 planos (2 loops de 5)

    // Geometría y curvas de mod_11715
    const stepSize = (b) => 0.62 * b.height + b.gutter;
    const loopRank = (val, count) => (count <= 0 ? 0 : -1 + (((val - -1) % count) + count) % count);
    const hermite = (dist) => {
      const t = Math.min(Math.abs(dist), 1);
      return 1 - t * t * (3 - 2 * t);
    };
    const entranceOffset = (p, b) => {
      const inv = 1 - p;
      return { dx: inv * b.height * 0.25, dy: -inv * b.height * 1.15 };
    };

    function computeLayout(offset, count, b) {
      const halfH = b.height / 2;
      const step = stepSize(b);
      const startX = -b.width / 2 + b.height;
      const ranks = Array.from({ length: count }, (_, idx) => loopRank(idx - offset, count));

      return ranks.map((rk) => {
        const minSide = 0.62 * b.height;
        const deltaSide = b.height - minSide;
        const side = minSide + deltaSide * hermite(rk);
        let shift = 0;
        for (let j = 0; j < count; j++) {
          if (ranks[j] > rk) {
            shift += deltaSide * hermite(ranks[j]);
          }
        }
        const x = startX + rk * step - shift - side / 2;
        const y = -halfH + side / 2;
        return {
          x,
          y,
          side,
          left: b.width / 2 + x - side / 2,
          top: b.height / 2 - y - side / 2
        };
      });
    }

    // Estado del motor de galería (mod_96767)
    let bounds = { width: 800, height: 320, gutter: 12 };
    let offsetD = 0;        // Posición continua del carrusel
    let velG = 0;           // Velocidad de momentum
    let dragVelO = 0;       // Velocidad instantánea de drag
    let stateH = 'entrance'; // 'entrance' | 'idle' | 'momentum' | 'snapping' | 'dragging'
    let activeIdx = 0;
    let prevOffsetQ = 0;
    let scrollAberrX = 0;   // Aberración horizontal global por velocidad
    const planeAberrK = planeEls.map(() => ({ x: 0, y: 0 })); // Aberración local por tarjeta
    const entranceP = planeEls.map((_, idx) => ({
      p: loopRank(idx, instanceCount) < 0 ? 1 : 0,
      delay: Math.max(0, loopRank(idx, instanceCount)) * 0.08
    }));
    let entranceElapsed = -0.25; // Pequeña espera inicial (PHASE_GALLERY = 0.3s)

    // Estado de snapping tween
    let snapStartOffset = 0;
    let snapTargetOffset = 0;
    let snapProgress = 0;
    const SNAP_DURATION = 0.5;

    // Estado de HoverPill y puntero
    let hoveredPlane = -1;
    let pointerClient = { x: 0, y: 0 };
    let boundsRect = { left: 0, top: 0 };
    let lastGalleryPointer = null;
    let screenRects = [];

    function updateHoverPill() {
      if (!pillMaskEl || !pillBoxEl || !pillBgEl || !pillMarqueeEl) return;
      if (hoveredPlane < 0 || !screenRects[hoveredPlane]) {
        pillBgEl.style.transform = 'scale(0)';
        pillMarqueeEl.style.opacity = '0';
        return;
      }
      const rect = screenRects[hoveredPlane];
      pillMaskEl.style.transform = `translate3d(${rect.left.toFixed(1)}px, ${rect.top.toFixed(1)}px, 0)`;
      pillMaskEl.style.width = `${rect.side.toFixed(1)}px`;
      pillMaskEl.style.height = `${rect.side.toFixed(1)}px`;

      const localX = pointerClient.x - boundsRect.left - rect.left;
      const localY = pointerClient.y - boundsRect.top - rect.top;
      pillBoxEl.style.transform = `translate3d(${localX.toFixed(1)}px, ${localY.toFixed(1)}px, 0) translate(-50%, -50%)`;
      pillBgEl.style.transform = 'scale(1)';
      pillMarqueeEl.style.opacity = '1';
    }

    function syncActiveProject() {
      const target = Math.round(offsetD);
      const nextActive = ((target % M) + M) % M;
      if (nextActive !== activeIdx) {
        activeIdx = nextActive;
        const proj = projects[activeIdx];
        if (clientEl) clientEl.textContent = proj.client;
        if (roleEl) roleEl.textContent = proj.role;
        if (counterEl) {
          counterEl.textContent = `${String(activeIdx + 1).padStart(2, '0')}/${String(M).padStart(2, '0')}`;
        }
      }
    }

    function renderGalleryFrame() {
      const baseRects = computeLayout(offsetD, instanceCount, bounds);
      screenRects = baseRects.map((r, i) => {
        const { dx, dy } = entranceOffset(entranceP[i].p, bounds);
        return {
          left: r.left + dx,
          top: r.top - dy,
          side: r.side
        };
      });

      planeEls.forEach((el, i) => {
        const rect = screenRects[i];
        el.style.transform = `translate3d(${rect.left.toFixed(2)}px, ${rect.top.toFixed(2)}px, 0)`;
        el.style.width = `${rect.side.toFixed(2)}px`;
        el.style.height = `${rect.side.toFixed(2)}px`;

        // Escalar sutilmente el resumen interno según si la tarjeta se acerca al 100%
        const summary = el.querySelector('.card-summary');
        if (summary) {
          const ratio = (rect.side / bounds.height - 0.62) / 0.38;
          summary.style.opacity = String(Math.max(0, Math.min(1, ratio)));
        }

        // Aplicar filtro SVG de aberración cromática por velocidad + cursor (uAberr de mod_96767)
        const totalAberrX = (planeAberrK[i].x + scrollAberrX) * 240;
        const totalAberrY = planeAberrK[i].y * 240;
        const redNode = document.getElementById(`card-red-${i}`);
        const blueNode = document.getElementById(`card-blue-${i}`);

        if (Math.abs(totalAberrX) > 0.15 || Math.abs(totalAberrY) > 0.15) {
          if (redNode && blueNode) {
            redNode.setAttribute('dx', totalAberrX.toFixed(2));
            redNode.setAttribute('dy', totalAberrY.toFixed(2));
            blueNode.setAttribute('dx', (-totalAberrX).toFixed(2));
            blueNode.setAttribute('dy', (-totalAberrY).toFixed(2));
            el.style.filter = `url(#card-split-${i})`;
          }
        } else {
          el.style.filter = '';
        }
      });

      updateHoverPill();
    }

    let galleryRaf = null;
    let lastFrameTime = performance.now();

    function stepGallery(now) {
      const dt = Math.min((now - lastFrameTime) / 1000, 1 / 30);
      lastFrameTime = now;

      // 1. Entrada escalonada (entrance)
      if (stateH === 'entrance') {
        entranceElapsed += dt;
        let allDone = true;
        for (let i = 0; i < instanceCount; i++) {
          if (entranceP[i].p < 1) {
            const t = Math.max(0, (entranceElapsed - entranceP[i].delay) / 0.7);
            if (t < 1) {
              allDone = false;
              entranceP[i].p = 1 - Math.pow(1 - t, 3); // power3.out
            } else {
              entranceP[i].p = 1;
            }
          }
        }
        if (allDone) stateH = 'idle';
      }

      // 2. Momentum y transición a Snapping
      if (stateH === 'momentum') {
        offsetD += velG * dt;
        velG = decayVelocity(velG, dt, 0.92);
        if (Math.abs(velG) < 0.12) {
          velG = 0;
          stateH = 'snapping';
          snapStartOffset = offsetD;
          snapTargetOffset = Math.round(offsetD);
          snapProgress = 0;
        }
      } else if (stateH === 'snapping') {
        snapProgress += dt / SNAP_DURATION;
        if (snapProgress >= 1) {
          offsetD = snapTargetOffset;
          stateH = 'idle';
        } else {
          const ease = 1 - Math.pow(1 - snapProgress, 3); // power3.out
          offsetD = snapStartOffset + (snapTargetOffset - snapStartOffset) * ease;
        }
      } else if (stateH === 'dragging') {
        dragVelO = decayVelocity(dragVelO, dt, 0.85);
      }

      // 3. Aberración cromática por velocidad de desplazamiento (X) y por tarjeta (K)
      const speed = dt > 0 ? (offsetD - prevOffsetQ) / dt : 0;
      prevOffsetQ = offsetD;
      const excessSpeed = Math.max(Math.abs(speed) - 0.15, 0);
      const targetAberrX = Math.sign(speed) * Math.min(0.0075 * excessSpeed, 0.038);
      scrollAberrX += (targetAberrX - scrollAberrX) * (1 - Math.pow(0.72, 60 * dt));

      let hasActiveAberr = false;
      if (Math.abs(scrollAberrX) < 0.0002) {
        scrollAberrX = 0;
      } else {
        hasActiveAberr = true;
      }

      for (let i = 0; i < instanceCount; i++) {
        planeAberrK[i].x = decayVelocity(planeAberrK[i].x, dt, 0.86);
        planeAberrK[i].y = decayVelocity(planeAberrK[i].y, dt, 0.86);
        if (Math.abs(planeAberrK[i].x) < 0.0002 && Math.abs(planeAberrK[i].y) < 0.0002) {
          planeAberrK[i].x = 0;
          planeAberrK[i].y = 0;
        } else {
          hasActiveAberr = true;
        }
      }

      syncActiveProject();
      renderGalleryFrame();

      if (stateH !== 'idle' || hasActiveAberr) {
        galleryRaf = requestAnimationFrame(stepGallery);
      } else {
        galleryRaf = null;
      }
    }

    function ensureGalleryLoop() {
      if (galleryRaf === null) {
        lastFrameTime = performance.now();
        galleryRaf = requestAnimationFrame(stepGallery);
      }
    }

    function measureGalleryBounds() {
      if (!boundsEl || !gutterProbe) return;
      const r = boundsEl.getBoundingClientRect();
      const g = gutterProbe.getBoundingClientRect().width || 12;
      boundsRect = { left: r.left, top: r.top };
      if (r.width > 0 && r.height > 0) {
        bounds = { width: r.width, height: r.height, gutter: g };
        renderGalleryFrame();
      }
    }

    measureGalleryBounds();
    if (window.__portfolioLoaderDone) {
      ensureGalleryLoop();
    } else {
      window.addEventListener('portfolio:loader-done', () => {
        ensureGalleryLoop();
      }, { once: true });
    }

    const ro = new ResizeObserver(measureGalleryBounds);
    if (boundsEl) ro.observe(boundsEl);
    window.addEventListener('scroll', measureGalleryBounds, { passive: true });

    // Rueda del mouse (Input de momentum continuo idéntico a mod_96767)
    window.addEventListener(
      'wheel',
      (e) => {
        if (document.getElementById('side-drawer')?.getAttribute('aria-hidden') === 'false') return;
        if (window.innerWidth < 1024) return;
        e.preventDefault();
        if (stateH === 'entrance' || stateH === 'dragging') return;
        const delta = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        velG += 0.0045 * delta;
        stateH = 'momentum';
        ensureGalleryLoop();
      },
      { passive: false }
    );

    // Drag & Pointer interactions en el escenario de la galería
    let isPointerDown = false;
    let dragLastX = 0;
    let dragDistance = 0;
    let dragLastStamp = 0;
    let suppressClick = false;

    boundsEl?.addEventListener('pointerover', (e) => {
      const card = e.target.closest('[data-plane]');
      if (card) {
        hoveredPlane = Number(card.dataset.plane);
        updateHoverPill();
      }
    });

    boundsEl?.addEventListener('pointerout', (e) => {
      const rel = e.relatedTarget;
      if (!rel || !boundsEl.contains(rel) || !rel.closest('[data-plane]')) {
        hoveredPlane = -1;
        updateHoverPill();
      }
    });

    boundsEl?.addEventListener('pointermove', (e) => {
      pointerClient = { x: e.clientX, y: e.clientY };
      const localX = e.clientX - boundsRect.left;
      const localY = e.clientY - boundsRect.top;

      if (lastGalleryPointer && hoveredPlane >= 0 && hoveredPlane < instanceCount) {
        const k = planeAberrK[hoveredPlane];
        k.x = clampSym(k.x + (localX - lastGalleryPointer.x) * 0.00009, 0.018);
        k.y = clampSym(k.y - (localY - lastGalleryPointer.y) * 0.00009, 0.018);
        ensureGalleryLoop();
      }
      lastGalleryPointer = { x: localX, y: localY };
      updateHoverPill();
    });

    boundsEl?.addEventListener('pointerleave', () => {
      lastGalleryPointer = null;
      hoveredPlane = -1;
      updateHoverPill();
    });

    boundsEl?.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || stateH === 'entrance') return;
      isPointerDown = true;
      suppressClick = false;
      dragLastX = e.clientX;
      dragDistance = 0;
      velG = 0;
      dragVelO = 0;
      dragLastStamp = performance.now();
      stateH = 'dragging';
      ensureGalleryLoop();
    });

    window.addEventListener('pointermove', (e) => {
      if (!isPointerDown) return;
      const dx = e.clientX - dragLastX;
      dragLastX = e.clientX;
      dragDistance += Math.abs(dx);

      const step = stepSize(bounds);
      const dOffset = step > 0 ? -dx / step : 0;
      offsetD += dOffset;

      const now = performance.now();
      const dt = Math.max((now - dragLastStamp) / 1000, 1 / 240);
      dragLastStamp = now;
      dragVelO += (dOffset / dt - dragVelO) * 0.35;

      if (dragDistance > 8 && boundsEl) {
        boundsEl.style.cursor = 'grabbing';
      }
    });

    function endGalleryDrag() {
      if (!isPointerDown) return;
      isPointerDown = false;
      suppressClick = dragDistance > 8;
      if (boundsEl) boundsEl.style.cursor = 'grab';
      velG = clampSym(dragVelO, 9);
      stateH = 'momentum';
      ensureGalleryLoop();
    }

    window.addEventListener('pointerup', endGalleryDrag);
    window.addEventListener('pointercancel', endGalleryDrag);

